{
    "manifest_version": 3,
    "name": "News Node (Dev)",
    "version": "1.2.1",
    "description": "Dev Version - Logging Enabled",
    "permissions": [
      "activeTab",
      "identity",
      "storage"
    ],
    "oauth2": {
      "client_id": "307150378715-6k7401oof17j9gvg9dd83cvduv7n79s4.apps.googleusercontent.com",
      "scopes": [
        "https://www.googleapis.com/auth/userinfo.email",
        "https://www.googleapis.com/auth/userinfo.profile"
      ]
    },
    "host_permissions": [
      "http://localhost:8000/*" 
    ],
    "background": { "service_worker": "background.js" },
    "action": {
      "default_popup": "popup.html",
      "default_title": "News Node (Dev)",
      "default_icon": {
          "16": "icon16.png", 
          "48": "icon48.png",
          "128": "icon128.png"
      } 
    },
    "content_scripts": [
        {
        "matches": [
            "*://n.news.naver.com/*",
            "*://news.daum.net/*",
            
            "*://*.abc.net.au/*",    
            "*://*.bbc.com/*"
        ],
        "js": ["config.js", "content_script.js"],
        "run_at": "document_idle"
        }
    ],
    "icons": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }